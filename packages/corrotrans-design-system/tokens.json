{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Corrotrans Mobility's shared design tokens in W3C DTCG format. This file is the single source of truth for the blue-and-yellow palette, DM Sans typography, rounded surfaces, and light/dark themes.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#edf2f7" },
      "authBackground": { "$value": "#fff7db" },
      "foreground": { "$value": "#172435" },
      "border": { "$value": "#d5dde6" },
      "card": { "$value": "#fffefa" },
      "cardForeground": { "$value": "#172435" },
      "popover": { "$value": "#fffefa" },
      "popoverForeground": { "$value": "#172435" },
      "primary": {
        "$value": "#0d5ace",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#fffbf0" },
      "secondary": { "$value": "#fad21e" },
      "secondaryForeground": { "$value": "#172435" },
      "muted": { "$value": "#e1e7ef" },
      "mutedForeground": { "$value": "#48596f" },
      "accent": { "$value": "#e0f3ff" },
      "accentForeground": { "$value": "#0b4eb1" },
      "success": { "$value": "#21845f" },
      "successForeground": { "$value": "#ffffff" },
      "warning": { "$value": "#a45513" },
      "warningForeground": { "$value": "#ffffff" },
      "info": { "$value": "#3971b9" },
      "infoForeground": { "$value": "#ffffff" },
      "destructive": {
        "$value": "#c13b30",
        "$description": "Accessible, darker variant of Corrotrans red for destructive controls."
      },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d5dde6" },
      "ring": { "$value": "#0e63e1" },
      "overlay": { "$value": "#0a17288f" },
      "chart1": { "$value": "#0d5ace" },
      "chart2": { "$value": "#21845f" },
      "chart3": { "$value": "#b96819" },
      "chart4": { "$value": "#7154ae" },
      "chart5": { "$value": "#e24a3c" },
      "sidebar": { "$value": "#123c76" },
      "sidebarForeground": { "$value": "#fffbf0" },
      "sidebarBorder": { "$value": "#0e356d" },
      "sidebarPrimary": { "$value": "#fad21e" },
      "sidebarPrimaryForeground": { "$value": "#172435" },
      "sidebarAccent": { "$value": "#1f4a80" },
      "sidebarAccentForeground": { "$value": "#ffffff" },
      "sidebarRing": { "$value": "#fad21e" }
    },
    "dark": {
      "background": { "$value": "#121a26" },
      "authBackground": { "$value": "#29261c" },
      "foreground": { "$value": "#fffbf0" },
      "border": { "$value": "#2c3849" },
      "card": { "$value": "#1a2432" },
      "cardForeground": { "$value": "#fffbf0" },
      "popover": { "$value": "#1a2432" },
      "popoverForeground": { "$value": "#fffbf0" },
      "primary": { "$value": "#3187f6" },
      "primaryForeground": { "$value": "#101a27" },
      "secondary": { "$value": "#fad21e" },
      "secondaryForeground": { "$value": "#172435" },
      "muted": { "$value": "#283343" },
      "mutedForeground": { "$value": "#a5b1c0" },
      "accent": { "$value": "#193458" },
      "accentForeground": { "$value": "#c7e9ff" },
      "success": { "$value": "#4eb486" },
      "successForeground": { "$value": "#07170f" },
      "warning": { "$value": "#e7a45c" },
      "warningForeground": { "$value": "#251507" },
      "info": { "$value": "#79aef4" },
      "infoForeground": { "$value": "#0d1724" },
      "destructive": { "$value": "#f06b5f" },
      "destructiveForeground": { "$value": "#121a26" },
      "input": { "$value": "#2c3849" },
      "ring": { "$value": "#3187f6" },
      "overlay": { "$value": "#020810b8" },
      "chart1": { "$value": "#5fa3ff" },
      "chart2": { "$value": "#57c695" },
      "chart3": { "$value": "#e7a45c" },
      "chart4": { "$value": "#b69aed" },
      "chart5": { "$value": "#f07068" },
      "sidebar": { "$value": "#0d1520" },
      "sidebarForeground": { "$value": "#fffbf0" },
      "sidebarBorder": { "$value": "#2c3849" },
      "sidebarPrimary": { "$value": "#3187f6" },
      "sidebarPrimaryForeground": { "$value": "#101a27" },
      "sidebarAccent": { "$value": "#283343" },
      "sidebarAccentForeground": { "$value": "#fffbf0" },
      "sidebarRing": { "$value": "#3187f6" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Shared Corrotrans UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1.15rem",
      "$description": "Rounded card and control radius used across Corrotrans surfaces."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
